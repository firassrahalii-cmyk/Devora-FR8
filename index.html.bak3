<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devora</title>
  <link rel="stylesheet" href="css/auth.css">
  <link rel="stylesheet" href="css/main.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <!-- CUSTOM CURSOR -->
  <div class="cursor-dot" id="cursorDot"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <!-- ==================== AUTH SECTION ==================== -->
  <div id="authSection">
    <canvas id="particleCanvas"></canvas>

    <div class="auth-wrapper">
      <div class="auth-card-container">

        <!-- LOGIN CARD -->
        <div id="loginCard" class="auth-card">
          <div class="auth-logo">
            <img src="images/devora-logo.svg" alt="Devora" class="auth-logo-img">
          </div>
          <h1 class="auth-title">Devora</h1>
          <p class="auth-subtitle">Welcome back! Sign in to continue.</p>

          <div id="loginError" class="error-message hidden"></div>

          <form id="loginForm" class="auth-form" autocomplete="off">
            <div class="field-group">
              <label for="loginEmail">Email</label>
              <div class="input-wrapper">
                <input type="email" id="loginEmail" placeholder="yourname@gmail.com" required>
              </div>
            </div>

            <div class="field-group">
              <label for="loginPassword">Password</label>
              <div class="input-wrapper">
                <input type="password" id="loginPassword" placeholder="Enter your password" required>
                <button type="button" class="toggle-pass" data-target="loginPassword">
                  <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
            </div>

            <button type="submit" class="auth-btn">
              <span class="btn-text">Sign In</span>
              <span class="spinner"></span>
            </button>
          </form>

          <div class="auth-switch">
            Don't have an account? <a href="#" id="showRegister">Create Account</a>
          </div>
        </div>

        <!-- REGISTER CARD -->
        <div id="registerCard" class="auth-card hidden">
          <div class="auth-logo">
            <img src="images/devora-logo.svg" alt="Devora" class="auth-logo-img">
          </div>
          <h1 class="auth-title">Devora</h1>
          <p class="auth-subtitle">Create your account to get started.</p>

          <div id="registerError" class="error-message hidden"></div>

          <form id="registerForm" class="auth-form" autocomplete="off">
            <div class="field-group">
              <label for="regEmail">Email</label>
              <div class="input-wrapper">
                <input type="email" id="regEmail" placeholder="yourname@gmail.com" required>
              </div>
              <span id="emailError" class="field-error hidden"></span>
            </div>

            <div class="field-group">
              <label for="regPassword">Password</label>
              <div class="input-wrapper">
                <input type="password" id="regPassword" placeholder="Create a password" required>
                <button type="button" class="toggle-pass" data-target="regPassword">
                  <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
              <ul class="password-requirements">
                <li id="reqLength"><span class="req-icon">✗</span> At least 8 characters</li>
                <li id="reqCapital"><span class="req-icon">✗</span> One uppercase letter</li>
                <li id="reqNumber"><span class="req-icon">✗</span> One number</li>
              </ul>
            </div>

            <div class="field-group">
              <label for="regConfirmPassword">Confirm Password</label>
              <div class="input-wrapper">
                <input type="password" id="regConfirmPassword" placeholder="Confirm your password" required>
                <button type="button" class="toggle-pass" data-target="regConfirmPassword">
                  <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
              <span id="confirmError" class="field-error hidden"></span>
            </div>

            <div class="field-group">
              <label for="regUsername">Username</label>
              <div class="input-wrapper">
                <input type="text" id="regUsername" placeholder="e.g. ahmed_lolo" required>
              </div>
              <span class="field-hint">Lowercase letters, numbers, and underscores only.</span>
              <span id="usernameError" class="field-error hidden"></span>
            </div>

            <div class="field-group">
              <label for="regName">Name</label>
              <div class="input-wrapper">
                <input type="text" id="regName" placeholder="Your display name" required>
              </div>
              <span class="field-hint">Max 18 words.</span>
              <span id="nameError" class="field-error hidden"></span>
            </div>

            <button type="submit" class="auth-btn">
              <span class="btn-text">Create Account</span>
              <span class="spinner"></span>
            </button>
          </form>

          <div class="auth-switch">
            Already have an account? <a href="#" id="showLogin">Sign In</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ==================== APP SECTION ==================== -->
  <div id="appSection" class="hidden">
    <div class="app-layout">

      <!-- SIDEBAR -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <div class="logo-wrapper">
            <img src="images/devora-logo.svg" alt="Devora" class="logo-img">
          </div>
          <span class="logo-text">Devora</span>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-item active" data-section="dashboard">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
            </span>
            <span>Dashboard</span>
          </div>
          <div class="nav-item" data-section="projects">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
            </span>
            <span>Projects</span>
          </div>
          <div class="nav-item" data-section="arena">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </span>
            <span>Dev Arena</span>
          </div>
          <div class="nav-item" data-section="ai">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a4 4 0 0 1 4 4v1a2 2 0 0 1 2 2h1a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-1a2 2 0 0 1-2 2v1a4 4 0 0 1-8 0v-1a2 2 0 0 1-2-2h-1a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h1a2 2 0 0 1 2-2V6a4 4 0 0 1 4-4z"/>
                <circle cx="9" cy="12" r="1" fill="currentColor"/>
                <circle cx="15" cy="12" r="1" fill="currentColor"/>
              </svg>
            </span>
            <span>Devora AI</span>
          </div>
          <div class="nav-item" data-section="cyber">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </span>
            <span>Cybersecurity</span>
          </div>
        </nav>

        <div class="sidebar-footer">
          <div class="profile-trigger" id="profileTrigger">
            <div class="profile-avatar">
              <span class="profile-letter" id="sidebarLetter">D</span>
            </div>
            <span class="profile-name" id="sidebarUsername">user</span>
          </div>
          <div class="profile-dropdown hidden" id="profileDropdown">
            <a href="#" data-action="edit-profile">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Edit Profile
            </a>
            <a href="#" data-action="view-profile">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              View Profile
            </a>
            <a href="#" data-action="logout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Logout
            </a>
          </div>
        </div>
      </aside>

      <!-- SIDEBAR OVERLAY (mobile) -->
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <!-- MAIN CONTENT -->
      <main class="main-content">
        <div class="topbar">
          <button class="hamburger-btn" id="hamburgerBtn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <span class="topbar-title" id="topbarTitle">Dashboard</span>
        </div>

        <div class="content-area">

          <!-- ========== DASHBOARD ========== -->
          <div id="dashboardSection">
            <div class="welcome-card">
              <div class="welcome-glow"></div>
              <div class="welcome-content">
                <div class="welcome-badge">Developer Platform</div>
                <h1>Welcome to <span class="welcome-brand">Devora</span></h1>
                <p>Your all-in-one platform for developers and cybersecurity enthusiasts. Learn, build, and grow.</p>
                <div class="welcome-actions">
                  <button class="welcome-btn primary" onclick="document.querySelector('[data-section=arena]').click()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    Start Coding
                  </button>
                  <button class="welcome-btn secondary" onclick="document.querySelector('[data-section=projects]').click()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    Browse Projects
                  </button>
                </div>
              </div>
              <div class="welcome-visual">
                <div class="welcome-code-block">
                  <div class="code-dots"><span></span><span></span><span></span></div>
                  <pre><code><span class="code-kw">function</span> <span class="code-fn">buildFuture</span>() {
  <span class="code-kw">const</span> skills = <span class="code-str">learn()</span>;
  <span class="code-kw">const</span> projects = <span class="code-str">create()</span>;
  <span class="code-kw">return</span> skills + projects;
}</code></pre>
                </div>
              </div>
            </div>

            <div class="features-grid">
              <div class="feature-card">
                <div class="feature-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <h3>Dev Arena</h3>
                <p>Challenge yourself across 22 programming languages with 220+ curated problems.</p>
                <div class="feature-stat">
                  <span class="stat-number">220+</span>
                  <span class="stat-label">Challenges</span>
                </div>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                </div>
                <h3>Projects</h3>
                <p>Showcase your work, get feedback, and discover what others are building.</p>
                <div class="feature-stat">
                  <span class="stat-number">∞</span>
                  <span class="stat-label">Possibilities</span>
                </div>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Community</h3>
                <p>Join developers worldwide. Share knowledge, collaborate, and grow together.</p>
                <div class="feature-stat">
                  <span class="stat-number">22</span>
                  <span class="stat-label">Languages</span>
                </div>
              </div>
            </div>

            <div class="discord-section">
              <div class="discord-content">
                <div class="discord-icon-wrap">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                  </svg>
                </div>
                <div class="discord-text">
                  <h3>Join our Discord</h3>
                  <p>Connect with developers, share knowledge, and grow together.</p>
                </div>
              </div>
              <a href="https://discord.gg/f2DFQPZKX" target="_blank" rel="noopener noreferrer" class="discord-btn">
                Join Server
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </div>

          <!-- ========== PROJECTS ========== -->
          <div id="projectsSection" class="hidden">
            <div class="projects-header">
              <h1>Projects</h1>
              <button class="btn-primary create-project-btn">
                <span>Create New Project +</span>
              </button>
            </div>
            <div id="projectList" class="project-list"></div>
          </div>

          <!-- ========== DEV ARENA ========== -->
          <div id="arenaSection" class="hidden">
            <div class="arena-header">
              <h1>Dev Arena</h1>
            </div>
            <div id="totalScore" class="total-score"></div>
            <div id="languageGrid" class="language-grid"></div>
            <div id="arenaDetail" class="hidden">
              <div id="arenaDetailHeader" class="arena-detail-header"></div>
              <div id="questionList" class="questions-list"></div>
            </div>
          </div>

          <!-- ========== DEVORA AI ========== -->
          <div id="aiSection" class="hidden">
            <div class="ai-chat-container">
              <div class="ai-header">
                <button class="ai-new-chat-btn" id="aiNewChatBtn" title="New Chat">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                  <span>New Chat</span>
                </button>
                <div class="ai-header-actions">
                  <div class="ai-status">
                    <span class="ai-status-dot" id="aiStatusDot"></span>
                    <span class="ai-status-text" id="aiStatusText">Connecting...</span>
                  </div>
                  <button class="ai-settings-btn" id="aiSettingsBtn" title="AI Settings">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- AI Settings Panel -->
              <div class="ai-settings-panel" id="aiSettingsPanel">
                <div class="ai-settings-content">
                  <h3>AI Settings</h3>
                  <p class="ai-settings-desc">Add your Hugging Face API key for better responses. Get a free key at <a href="https://huggingface.co/settings/tokens" target="_blank">huggingface.co</a></p>
                  <div class="ai-settings-form">
                    <input type="password" id="aiApiKey" placeholder="hf_xxxxxxxxxxxxxxxxxxxx" class="ai-api-input">
                    <div class="ai-settings-actions">
                      <button class="ai-settings-save" id="aiSaveKeyBtn">Save Key</button>
                      <button class="ai-settings-clear" id="aiClearKeyBtn">Clear</button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="ai-messages" id="aiMessages">
                <div class="ai-welcome">
                  <div class="ai-welcome-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a4 4 0 0 1 4 4v1a2 2 0 0 1 2 2h1a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-1a2 2 0 0 1-2 2v1a4 4 0 0 1-8 0v-1a2 2 0 0 1-2-2h-1a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h1a2 2 0 0 1 2-2V6a4 4 0 0 1 4-4z"/>
                      <circle cx="9" cy="12" r="1" fill="currentColor"/>
                      <circle cx="15" cy="12" r="1" fill="currentColor"/>
                    </svg>
                  </div>
                  <h3>Hey, I'm Devora</h3>
                  <p>Your AI companion. Ask me anything, tell me about your day, or just say hi.</p>
                  <div class="ai-suggestions">
                    <button class="ai-suggestion" data-msg="How's your day going?">How's your day going?</button>
                    <button class="ai-suggestion" data-msg="Tell me something interesting">Tell me something interesting</button>
                    <button class="ai-suggestion" data-msg="Recommend me a good movie">Recommend a movie</button>
                    <button class="ai-suggestion" data-msg="I need some life advice">I need advice</button>
                  </div>
                </div>
              </div>

              <div class="ai-input-area">
                <div class="ai-input-wrapper">
                  <textarea id="aiInput" placeholder="Message Devora AI..." rows="1"></textarea>
                  <button class="ai-send-btn" id="aiSendBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="22" y1="2" x2="11" y2="13"/>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                  </button>
                </div>
                <div class="ai-notice">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ai-notice-icon">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                  </svg>
                  <span>Devora AI is currently <strong>under development</strong> and may produce inaccurate or incomplete responses. We are actively working on improving its accuracy and capabilities.</span>
                </div>
                <div class="ai-footer">
                  <p class="ai-credit">Developed by <strong>Firas</strong></p>
                </div>
              </div>
            </div>
          </div>

          <!-- ========== CYBERSECURITY ========== -->
          <div id="cyberSection" class="hidden">
            <div class="cyber-hero">
              <div class="cyber-hero-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <h1>Cybersecurity</h1>
              <p>Comprehensive guide to cybersecurity concepts, practices, and technologies</p>
            </div>

            <div class="cyber-grid">

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-blue">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3>Cybersecurity</h3>
                <p>The practice of protecting computers, networks, applications, systems, and data from unauthorized access, attacks, damage, or disruption.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-cyan">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <h3>Network Security</h3>
                <p>The practice of protecting computer networks from unauthorized access, attacks, misuse, and security threats.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-purple">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </div>
                <h3>Web Security</h3>
                <p>The practice of protecting websites and web applications from vulnerabilities, attacks, and unauthorized access.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-orange">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="9" y1="7" x2="15" y2="7"/><line x1="9" y1="11" x2="15" y2="11"/></svg>
                </div>
                <h3>Linux Security</h3>
                <p>The process of protecting Linux systems through secure configurations, access controls, updates, monitoring, and threat prevention.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-green">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <h3>Application Security</h3>
                <p>The practice of identifying and fixing security vulnerabilities in software applications throughout their development and operation.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-red">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                </div>
                <h3>Penetration Testing</h3>
                <p>An authorized security assessment where testers simulate attacks against systems to identify and report vulnerabilities.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-yellow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <h3>Vulnerability Assessment</h3>
                <p>The process of identifying, analyzing, and prioritizing security weaknesses in systems, networks, or applications.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-teal">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Digital Forensics</h3>
                <p>The process of collecting and analyzing digital evidence to investigate security incidents or other cyber-related events.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-indigo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                </div>
                <h3>Security Analysis</h3>
                <p>The process of examining systems, logs, networks, and security events to identify potential threats and vulnerabilities.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-rose">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <h3>Incident Response</h3>
                <p>The organized process of detecting, investigating, containing, and recovering from cybersecurity incidents.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-emerald">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <h3>Threat Intelligence</h3>
                <p>The collection and analysis of information about cyber threats to help organizations understand and respond to potential attacks.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-amber">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3>Cryptography</h3>
                <p>The use of mathematical techniques to protect information through encryption, decryption, authentication, and integrity mechanisms.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-sky">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
                </div>
                <h3>Encryption</h3>
                <p>The process of converting readable information into an encoded form that can only be accessed using the appropriate key.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-lime">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                </div>
                <h3>Authentication</h3>
                <p>The process of verifying the identity of a user, device, or system.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-violet">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                </div>
                <h3>Authorization</h3>
                <p>The process of determining what an authenticated user or system is allowed to access or perform.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-fuchsia">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <h3>Identity & Access Management</h3>
                <p>A framework for managing digital identities and controlling access to systems and resources.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-lime">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <h3>Malware Analysis</h3>
                <p>The process of examining malicious software to understand its behavior, capabilities, and potential impact.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-orange">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
                </div>
                <h3>Firewall Security</h3>
                <p>The use of firewalls to monitor and control network traffic according to defined security rules.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-cyan">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/></svg>
                </div>
                <h3>Cloud Security</h3>
                <p>The practice of protecting cloud-based systems, applications, infrastructure, and data from security threats.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-teal">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                </div>
                <h3>Mobile Security</h3>
                <p>The practice of protecting mobile devices, applications, networks, and data from security threats.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-amber">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
                </div>
                <h3>Password Security</h3>
                <p>The use of secure password practices and authentication mechanisms to prevent unauthorized account access.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-rose">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3>Ethical Hacking</h3>
                <p>Authorized security testing performed to identify vulnerabilities and help improve the security of systems.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-blue">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                </div>
                <h3>OSINT</h3>
                <p>The process of collecting and analyzing information from publicly available sources for legitimate research or security purposes.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-indigo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                </div>
                <h3>Wireless Security</h3>
                <p>The practice of protecting wireless networks and communications from unauthorized access and attacks.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-emerald">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <h3>System Security</h3>
                <p>The practice of protecting operating systems, computers, and system resources against unauthorized access and threats.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-purple">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                </div>
                <h3>Database Security</h3>
                <p>The practice of protecting databases and their information from unauthorized access, modification, disclosure, or destruction.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-sky">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </div>
                <h3>API Security</h3>
                <p>The practice of protecting APIs from unauthorized access, abuse, data exposure, and other security threats.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-violet">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
                <h3>Security Compliance</h3>
                <p>The process of ensuring that an organization follows applicable security standards, policies, regulations, and requirements.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-red">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <h3>Zero Trust</h3>
                <p>A security model based on the principle of continuously verifying users, devices, and access requests rather than automatically trusting them.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-rose">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                </div>
                <h3>Red Team</h3>
                <p>An authorized security team that simulates realistic attacks to test an organization's defenses.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-blue">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
                <h3>Blue Team</h3>
                <p>A security team responsible for defending systems, detecting threats, investigating incidents, and improving security controls.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-fuchsia">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                </div>
                <h3>Purple Team</h3>
                <p>A collaborative approach where offensive and defensive security teams work together to improve an organization's security.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-amber">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <h3>SOC</h3>
                <p>A team or facility responsible for continuously monitoring systems, detecting threats, and responding to security incidents.</p>
              </div>

              <div class="cyber-card">
                <div class="cyber-card-icon cyber-icon-emerald">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <h3>CTF</h3>
                <p>A cybersecurity competition where participants solve security-related challenges to find hidden flags and demonstrate their skills.</p>
              </div>

            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- ==================== MODALS ==================== -->

  <!-- Create Project Modal -->
  <div id="createProjectModal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" onclick="closeModal('createProjectModal')">&times;</button>
      <h2>Create New Project</h2>
      <form id="createProjectForm">
        <div class="form-group">
          <label for="project-title">Title Project *</label>
          <input type="text" id="project-title" placeholder="Enter project title" required>
        </div>
        <div class="form-group">
          <label for="project-description">Description *</label>
          <textarea id="project-description" placeholder="Describe your project" rows="4" required></textarea>
        </div>
        <div class="form-group">
          <label>Project Languages</label>
          <div class="language-checkboxes" id="languageCheckboxes">
            <label class="checkbox-item"><input type="checkbox" value="Python"> Python</label>
            <label class="checkbox-item"><input type="checkbox" value="Java"> Java</label>
            <label class="checkbox-item"><input type="checkbox" value="JavaScript"> JavaScript</label>
            <label class="checkbox-item"><input type="checkbox" value="HTML"> HTML</label>
            <label class="checkbox-item"><input type="checkbox" value="CSS"> CSS</label>
            <label class="checkbox-item"><input type="checkbox" value="PHP"> PHP</label>
            <label class="checkbox-item"><input type="checkbox" value="C"> C</label>
            <label class="checkbox-item"><input type="checkbox" value="C++"> C++</label>
            <label class="checkbox-item"><input type="checkbox" value="C#"> C#</label>
            <label class="checkbox-item"><input type="checkbox" value="Rust"> Rust</label>
            <label class="checkbox-item"><input type="checkbox" value="Go"> Go</label>
            <label class="checkbox-item"><input type="checkbox" value="Kotlin"> Kotlin</label>
            <label class="checkbox-item"><input type="checkbox" value="Swift"> Swift</label>
            <label class="checkbox-item"><input type="checkbox" value="TypeScript"> TypeScript</label>
            <label class="checkbox-item"><input type="checkbox" value="Ruby"> Ruby</label>
            <label class="checkbox-item"><input type="checkbox" value="Dart"> Dart</label>
            <label class="checkbox-item"><input type="checkbox" value="R"> R</label>
            <label class="checkbox-item"><input type="checkbox" value="Scala"> Scala</label>
            <label class="checkbox-item"><input type="checkbox" value="Lua"> Lua</label>
            <label class="checkbox-item"><input type="checkbox" value="Solidity"> Solidity</label>
            <label class="checkbox-item"><input type="checkbox" value="SQL"> SQL</label>
            <label class="checkbox-item"><input type="checkbox" value="Assembly"> Assembly</label>
          </div>
        </div>
        <div class="form-group">
          <label for="project-image">Link Images</label>
          <input type="url" id="project-image" placeholder="https://example.com/image.png">
        </div>
        <div class="form-group">
          <label for="project-github">Link GitHub</label>
          <input type="url" id="project-github" placeholder="https://github.com/username/repo">
        </div>
        <div class="form-group">
          <label for="project-other">Other Link</label>
          <input type="url" id="project-other" placeholder="https://example.com">
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary btn-cancel" id="btnCancelCreate">Cancel</button>
          <button type="button" class="btn-primary" id="btnSaveProject">Create Project</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Profile Modal (View) -->
  <div id="profileModal" class="modal-overlay">
    <div class="profile-modal-content">
      <button class="modal-close" onclick="closeModal('profileModal')">&times;</button>
      <div class="profile-header">
        <div class="profile-avatar-lg" id="profileAvatarLg">D</div>
        <div class="profile-display-name" id="profile-name">Name</div>
        <div class="profile-username" id="profile-username">@username</div>
      </div>
      <div class="profile-section">
        <h4>Description</h4>
        <p id="profile-description">Not set</p>
      </div>
      <div class="profile-section">
        <h4>Bio</h4>
        <p id="profile-bio">Not set</p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" onclick="closeModal('profileModal')">Close</button>
      </div>
    </div>
  </div>

  <!-- Edit Profile Modal -->
  <div id="editProfileModal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" onclick="closeModal('editProfileModal')">&times;</button>
      <h2>Edit Profile</h2>
      <form id="editProfileForm">
        <div class="form-group">
          <label for="edit-username">Username</label>
          <input type="text" id="edit-username" placeholder="e.g. ahmed_lolo">
          <span class="field-hint">Lowercase letters, numbers, and underscores only.</span>
        </div>
        <div class="form-group">
          <label for="edit-name">Name</label>
          <input type="text" id="edit-name" placeholder="Your display name">
        </div>
        <div class="form-group">
          <label for="edit-description">Description</label>
          <textarea id="edit-description" placeholder="Write something about yourself..." rows="3" maxlength="800"></textarea>
          <span class="field-hint">Max 800 characters.</span>
        </div>
        <div class="form-group">
          <label for="edit-bio">Bio</label>
          <textarea id="edit-bio" placeholder="Write your bio..." rows="3" maxlength="800"></textarea>
          <span class="field-hint">Max 800 characters.</span>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary btn-cancel">Cancel</button>
          <button type="button" class="btn-primary btn-save">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Question Modal (Arena) -->
  <div id="questionModal" class="modal-overlay code-modal"></div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteConfirmModal" class="modal-overlay">
    <div class="modal-content" style="max-width: 420px; text-align: center;">
      <h2>Confirm Delete</h2>
      <p style="color: var(--text-secondary); margin-bottom: 24px;">Are you sure you want to delete this project? This action cannot be undone.</p>
      <div class="modal-actions" style="justify-content: center;">
        <button type="button" class="btn-secondary btn-cancel-delete">Cancel</button>
        <button type="button" class="btn-danger btn-confirm-delete">Delete</button>
      </div>
    </div>
  </div>

  <!-- Author Profile Modal -->
  <div id="authorModal" class="modal-overlay">
    <div class="profile-modal-content">
      <button class="modal-close">&times;</button>
      <div class="profile-header">
        <img id="authorModalAvatar" src="" alt="" class="profile-avatar-img">
        <div class="profile-display-name" id="authorModalName"></div>
        <div class="profile-username" id="authorModalUsername"></div>
      </div>
      <div class="profile-section">
        <h4>Email</h4>
        <p id="authorModalEmail"></p>
      </div>
      <div class="profile-section">
        <h4>Description</h4>
        <p id="authorModalDescription">Not set</p>
      </div>
      <div class="profile-section">
        <h4>Bio</h4>
        <p id="authorModalBio">Not set</p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-secondary btn-close-author">Close</button>
      </div>
    </div>
  </div>

  <!-- JS FILES -->
  <script src="js/auth.js"></script>
  <script src="js/app.js"></script>
  <script src="js/projects.js"></script>
  <script src="js/arena.js"></script>
  <script src="js/ai.js"></script>

  <!-- Additional App Script for hamburger, nav titles -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Hamburger menu
      var hamburger = document.getElementById('hamburgerBtn');
      var sidebar = document.getElementById('sidebar');
      var overlay = document.getElementById('sidebarOverlay');
      if (hamburger) {
        hamburger.addEventListener('click', function() {
          sidebar.classList.toggle('open');
          overlay.classList.toggle('active');
        });
      }
      if (overlay) {
        overlay.addEventListener('click', function() {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
        });
      }

      // Nav title update
      var navItems = document.querySelectorAll('.nav-item[data-section]');
      var topbarTitle = document.getElementById('topbarTitle');
      var titles = { dashboard: 'Dashboard', projects: 'Projects', arena: 'Dev Arena', ai: 'Devora AI', cyber: 'Cybersecurity' };
      navItems.forEach(function(item) {
        item.addEventListener('click', function() {
          var section = item.getAttribute('data-section');
          if (topbarTitle) topbarTitle.textContent = titles[section] || section;
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
        });
      });
    });
  </script>

  <!-- CUSTOM CURSOR SCRIPT -->
  <script>
    (function() {
      var dot = document.getElementById('cursorDot');
      var ring = document.getElementById('cursorRing');
      if (!dot || !ring) return;

      var mouseX = 0, mouseY = 0;
      var ringX = 0, ringY = 0;
      var visible = false;

      document.addEventListener('mousemove', function(e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
        dot.style.left = mouseX + 'px';
        dot.style.top = mouseY + 'px';
        if (!visible) {
          visible = true;
          dot.style.opacity = '1';
          ring.style.opacity = '1';
        }
      });

      document.addEventListener('mouseleave', function() {
        visible = false;
        dot.style.opacity = '0';
        ring.style.opacity = '0';
      });

      document.addEventListener('mouseenter', function() {
        visible = true;
        dot.style.opacity = '1';
        ring.style.opacity = '1';
      });

      function animateRing() {
        ringX += (mouseX - ringX) * 0.15;
        ringY += (mouseY - ringY) * 0.15;
        ring.style.left = ringX + 'px';
        ring.style.top = ringY + 'px';
        requestAnimationFrame(animateRing);
      }
      animateRing();

      var hoverEls = 'a, button, .nav-item, .project-card, .lang-card, .language-card, .question-item, .discord-btn, .btn-primary, .btn-secondary, .btn-danger, .profile-trigger, .create-project-btn, .modal-close, .back-btn, .run-btn, .start-btn, .question-start-btn, .project-author, .checkbox-item, input, textarea, select, [data-action]';

      document.addEventListener('mouseover', function(e) {
        var t = e.target.closest(hoverEls);
        if (t) {
          ring.classList.add('cursor-hover');
          dot.classList.add('cursor-hover');
          if (t.closest('a') || t.closest('button') || t.closest('[data-action]') || t.classList.contains('btn-primary') || t.classList.contains('btn-secondary') || t.classList.contains('btn-danger') || t.classList.contains('discord-btn') || t.classList.contains('run-btn') || t.classList.contains('start-btn') || t.classList.contains('question-start-btn')) {
            ring.classList.add('cursor-pointer');
            dot.classList.add('cursor-pointer');
          }
          if (t.classList.contains('project-card') || t.classList.contains('lang-card') || t.classList.contains('language-card')) {
            ring.classList.add('cursor-card');
            dot.classList.add('cursor-card');
          }
        }
      });

      document.addEventListener('mouseout', function(e) {
        var t = e.target.closest(hoverEls);
        if (t) {
          ring.classList.remove('cursor-hover', 'cursor-pointer', 'cursor-card');
          dot.classList.remove('cursor-hover', 'cursor-pointer', 'cursor-card');
        }
      });

      document.addEventListener('mousedown', function() {
        ring.classList.add('cursor-active');
        dot.classList.add('cursor-active');
      });

      document.addEventListener('mouseup', function() {
        ring.classList.remove('cursor-active');
        dot.classList.remove('cursor-active');
      });
    })();
  </script>
</body>
</html>
